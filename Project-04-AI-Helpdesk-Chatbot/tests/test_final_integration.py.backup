"""
Module 6: Final Integration Tests.

Tests the complete end-to-end flow including:
- USER -> Flask API -> Validation -> Chatbot -> Intent Classifier ->
  FAQ Retriever -> Response Generator -> JSON Response
- ADMIN -> FAQ CREATE -> PERSISTENCE -> REFRESH -> USER CHAT ->
  UPDATED RESPONSE
- ADMIN -> FAQ UPDATE -> REFRESH -> USER CHAT -> UPDATED RESPONSE
- ADMIN -> FAQ DELETE -> REFRESH -> USER CHAT -> FALLBACK/EXPECTED RESPONSE
"""

from __future__ import annotations

import json
import os
import shutil
import sys
import time
from pathlib import Path

import pytest

PROJECT_ROOT = Path(__file__).resolve().parent.parent
SRC = PROJECT_ROOT / "src"
if str(SRC) not in sys.path:
    sys.path.insert(0, str(SRC))

from config import get_api_config, APIConfig  # noqa: E402
from chatbot import HelpdeskChatbot  # noqa: E402
from admin import FAQManager  # noqa: E402
from intent_classifier import IntentClassifier, load_model  # noqa: E402
from nlp_preprocessor import CANONICAL_INTENTS  # noqa: E402
from chatbot_config import ChatbotConfig  # noqa: E402

import pandas as pd  # noqa: E402

ORIGINAL_FAQ = PROJECT_ROOT / "data" / "processed" / "faq_nlp_ready.csv"


def _make_temp_faq_manager(tmp_path: Path):
    """Create a FAQManager backed by a temp copy of the FAQ dataset."""
    dest = tmp_path / "faq_nlp_ready.csv"
    shutil.copy2(ORIGINAL_FAQ, dest)
    config = ChatbotConfig(faq_nlp_ready_csv=dest)
    return FAQManager(faq_csv=dest, config=config)



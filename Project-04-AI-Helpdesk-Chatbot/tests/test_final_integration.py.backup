# ---------------------------------------------------------------------------
# 1. Full HTTP flow: USER -> API -> Chatbot -> Intent -> FAQ -> Response
# ---------------------------------------------------------------------------
class TestFullHttpFlow:
    def test_password_reset_end_to_end(self, client, chatbot):
        resp = client.post(
            "/api/chat",
            json={"message": "How do I reset my password?"},
        )
        assert resp.status_code == 200
        data = resp.get_json()
        assert data["success"] is True
        assert data["intent"] == "password_reset"
        assert data["confidence"] > 0
        assert not data["fallback"]
        assert len(data["response"]) > 0

    def test_working_hours_end_to_end(self, client, chatbot):
        resp = client.post(
            "/api/chat",
            json={"message": "What are the working hours?"},
        )
        assert resp.status_code == 200
        data = resp.get_json()
        assert data["intent"] == "working_hours"
        assert not data["fallback"]

    def test_laptop_problems_end_to_end(self, client, chatbot):
        resp = client.post(
            "/api/chat",
            json={"message": "My laptop is not working."},
        )
        assert resp.status_code == 200
        data = resp.get_json()
        assert data["intent"] == "laptop_problems"
        assert not data["fallback"]
        assert "laptop" in data["entities"]

    def test_gibberish_fallback(self, client, chatbot):
        resp = client.post(
            "/api/chat",
            json={"message": "asdfghjkl random nonsense"},
        )
        assert resp.status_code == 200
        data = resp.get_json()
        assert data["fallback"] is True

    def test_empty_message_validation(self, client, chatbot):
        resp = client.post("/api/chat", json={"message": ""})
        assert resp.status_code == 400
        data = resp.get_json()
        assert data["success"] is False

    def test_intent_classifier_integration(self, client, chatbot):
        """Verify the HTTP response intent matches direct classifier output."""
        question = "How do I reset my password?"
        direct = chatbot.classify(question)
        resp = client.post("/api/chat", json={"message": question})
        data = resp.get_json()
        assert data["intent"] == direct["intent"]

    def test_faq_retriever_integration(self, client, chatbot):
        """Verify the HTTP response contains a valid FAQ answer."""
        question = "How do I reset my password?"
        resp = client.post("/api/chat", json={"message": question})
        data = resp.get_json()
        direct = chatbot.get_response(question)
        assert data["response"] == direct.answer or data["fallback"] is True

    def test_response_generator_integration(self, client, chatbot):
        """Verify confidence and fallback fields are consistent."""
        question = "How do I reset my password?"
        direct = chatbot.get_response(question)
        resp = client.post("/api/chat", json={"message": question})
        data = resp.get_json()
        assert data["confidence_level"] == direct.confidence_level
        assert data["fallback"] == direct.is_fallback

    def test_entity_handler_integration(self, client, chatbot):
        """Verify entities are extracted correctly via API."""
        resp = client.post(
            "/api/chat",
            json={"message": "My laptop cannot connect to Wi-Fi."},
        )
        data = resp.get_json()
        assert "laptop" in data["entities"]
        assert "wifi" in data["entities"]

    def test_fallback_handler_integration(self, client, chatbot):
        """Verify fallback messages are returned for out-of-domain input."""
        resp = client.post(
            "/api/chat",
            json={"message": "How many atoms are in a mountain?"},
        )
        assert resp.status_code == 200
        data = resp.get_json()
        assert data["fallback"] is True
        assert len(data["response"]) > 0


# ---------------------------------------------------------------------------
# 2. Admin CRUD -> Refresh -> User Chat
# ---------------------------------------------------------------------------
class TestAdminCrudEndToEnd:
    """Test admin CRUD followed by chatbot verification."""

    def test_admin_create_then_chat(self, temp_faq_manager, tmp_path: Path):
        config = ChatbotConfig(faq_nlp_ready_csv=temp_faq_manager.faq_csv)
        from chatbot import HelpdeskChatbot

        bot = HelpdeskChatbot(config=config)

        # Admin creates a new FAQ with a distinctive answer.
        record = temp_faq_manager.create_faq(
            question="How do I book a conference room?",
            intent="office_location",
            answer="Use the Outlook calendar to book conference rooms.",
            entity="location",
        )
        assert record["id"] >= 1

        # Chatbot refreshes.
        bot.refresh_faq()

        # Verify the FAQ retriever can find the new answer.
        ans = bot.faq.get_answer("office_location", "How do I book a conference room?")
        assert ans is not None
        assert "Outlook" in ans

    def test_admin_update_then_chat(self, temp_faq_manager, tmp_path: Path):
        config = ChatbotConfig(faq_nlp_ready_csv=temp_faq_manager.faq_csv)
        from chatbot import HelpdeskChatbot

        bot = HelpdeskChatbot(config=config)

        # Create an FAQ.
        record = temp_faq_manager.create_faq(
            question="Test update FAQ unique abc123",
            intent="help",
            answer="Original answer.",
        )

        # Verify original answer by fetching the specific record.
        original = temp_faq_manager.get_faq(record["id"])
        assert original is not None
        assert original["answer"] == "Original answer."

        # Admin updates the answer.
        temp_faq_manager.update_faq(
            faq_id=record["id"],
            answer="Updated answer.",
        )
        bot.refresh_faq()

        # Verify updated answer by fetching the specific record.
        updated = temp_faq_manager.get_faq(record["id"])
        assert updated is not None
        assert updated["answer"] == "Updated answer."

    def test_admin_delete_then_chat(self, temp_faq_manager, tmp_path: Path):
        config = ChatbotConfig(faq_nlp_ready_csv=temp_faq_manager.faq_csv)
        from chatbot import HelpdeskChatbot

        bot = HelpdeskChatbot(config=config)

        # Create and then delete an FAQ.
        record = temp_faq_manager.create_faq(
            question="Test delete FAQ",
            intent="help",
            answer="To be deleted.",
        )
        temp_faq_manager.delete_faq(record["id"])
        bot.refresh_faq()

        # Verify FAQ retriever no longer has the answer.
        ans = bot.faq.get_answer("help", "Test delete FAQ unique xyz789")
        # The specific record should be gone; count should be back to pre-create level.
        assert temp_faq_manager.get_faq(record["id"]) is None


# ---------------------------------------------------------------------------
# 3. Admin API endpoints via Flask test client
# ---------------------------------------------------------------------------
class TestAdminApiEndpoints:
    def test_admin_list_faqs_no_key_allowed(self, client):
        """When ADMIN_API_KEY is not set, access is allowed with a warning."""
        resp = client.get("/api/admin/faqs")
        assert resp.status_code == 200
        data = resp.get_json()
        assert data["success"] is True
        assert "faqs" in data

    def test_admin_create_with_auth(self, client, tmp_path: Path):
        import time
        # Set a temp admin key for this test.
        os.environ["ADMIN_API_KEY"] = "test-key-123"
        try:
            unique_q = f"API create test {int(time.time() * 1000)}"
            resp = client.post(
                "/api/admin/faqs",
                json={
                    "question": unique_q,
                    "intent": "help",
                    "answer": "API answer.",
                },
                headers={"X-Admin-API-Key": "test-key-123"},
            )
            assert resp.status_code == 201
            data = resp.get_json()
            assert data["success"] is True
            assert data["intent"] == "help"
        finally:
            os.environ.pop("ADMIN_API_KEY", None)

    def test_admin_create_invalid_intent(self, client):
        import time
        os.environ["ADMIN_API_KEY"] = "test-key-123"
        try:
            unique_q = f"Bad intent test {int(time.time() * 1000)}"
            resp = client.post(
                "/api/admin/faqs",
                json={
                    "question": unique_q,
                    "intent": "not_valid",
                    "answer": "Answer.",
                },
                headers={"X-Admin-API-Key": "test-key-123"},
            )
            assert resp.status_code == 400
            data = resp.get_json()
            assert data["success"] is False
            assert "Invalid intent" in data["error"]
        finally:
            os.environ.pop("ADMIN_API_KEY", None)

    def test_admin_update_and_delete(self, client, tmp_path: Path):
        import time
        os.environ["ADMIN_API_KEY"] = "test-key-123"
        try:
            unique_q = f"Update-delete test {int(time.time() * 1000)}"
            # Create.
            create_resp = client.post(
                "/api/admin/faqs",
                json={
                    "question": unique_q,
                    "intent": "help",
                    "answer": "Original.",
                },
                headers={"X-Admin-API-Key": "test-key-123"},
            )
            assert create_resp.status_code == 201
            faq_id = create_resp.get_json()["id"]

            # Update.
            update_resp = client.put(
                f"/api/admin/faqs/{faq_id}",
                json={"answer": "Updated."},
                headers={"X-Admin-API-Key": "test-key-123"},
            )
            assert update_resp.status_code == 200
            assert update_resp.get_json()["answer"] == "Updated."

            # Delete.
            delete_resp = client.delete(
                f"/api/admin/faqs/{faq_id}",
                headers={"X-Admin-API-Key": "test-key-123"},
            )
            assert delete_resp.status_code == 200
            assert delete_resp.get_json()["success"] is True

            # Verify gone: no GET single-faq endpoint, so list should not contain it.
            list_resp = client.get(
                "/api/admin/faqs",
                headers={"X-Admin-API-Key": "test-key-123"},
            )
            assert list_resp.status_code == 200
            ids = [f["id"] for f in list_resp.get_json()["faqs"]]
            assert faq_id not in ids
        finally:
            os.environ.pop("ADMIN_API_KEY", None)

    def test_admin_reload(self, client):
        os.environ["ADMIN_API_KEY"] = "test-key-123"
        try:
            resp = client.post(
                "/api/admin/reload",
                headers={"X-Admin-API-Key": "test-key-123"},
            )
            assert resp.status_code == 200
            data = resp.get_json()
            assert data["success"] is True
            assert "reloaded" in data["message"].lower()
        finally:
            os.environ.pop("ADMIN_API_KEY", None)

    def test_admin_auth_failure(self, client):
        os.environ["ADMIN_API_KEY"] = "correct-key"
        try:
            resp = client.get(
                "/api/admin/faqs",
                headers={"X-Admin-API-Key": "wrong-key"},
            )
            assert resp.status_code == 403
            data = resp.get_json()
            assert data["success"] is False
        finally:
            os.environ.pop("ADMIN_API_KEY", None)


# ---------------------------------------------------------------------------
# 4. Regression tests for existing functionality
# ---------------------------------------------------------------------------
class TestRegressionAfterAdmin:
    """Verify admin changes do not break existing chatbot behavior."""

    def test_password_reset_still_works(self, client, chatbot):
        resp = client.post(
            "/api/chat",
            json={"message": "How do I reset my password?"},
        )
        assert resp.status_code == 200
        data = resp.get_json()
        assert data["intent"] == "password_reset"
        assert not data["fallback"]

    def test_working_hours_still_works(self, client, chatbot):
        resp = client.post(
            "/api/chat",
            json={"message": "What are the working hours?"},
        )
        assert resp.status_code == 200
        data = resp.get_json()
        assert data["intent"] == "working_hours"
        assert not data["fallback"]

    def test_laptop_problems_still_works(self, client, chatbot):
        resp = client.post(
            "/api/chat",
            json={"message": "My laptop is not working."},
        )
        assert resp.status_code == 200
        data = resp.get_json()
        assert data["intent"] == "laptop_problems"
        assert not data["fallback"]

    def test_email_problems_still_works(self, client, chatbot):
        resp = client.post(
            "/api/chat",
            json={"message": "I cannot log into my email."},
        )
        assert resp.status_code == 200
        data = resp.get_json()
        assert data["intent"] == "email_problems"
        assert not data["fallback"]

    def test_wifi_problems_still_works(self, client, chatbot):
        resp = client.post(
            "/api/chat",
            json={"message": "How do I connect to WiFi?"},
        )
        assert resp.status_code == 200
        data = resp.get_json()
        assert data["intent"] == "wifi_problems"
        assert not data["fallback"]

    def test_account_access_still_works(self, client, chatbot):
        resp = client.post(
            "/api/chat",
            json={"message": "I cannot access my account."},
        )
        assert resp.status_code == 200
        data = resp.get_json()
        assert data["intent"] == "account_access"
        assert not data["fallback"]

    def test_fallback_still_works(self, client, chatbot):
        resp = client.post(
            "/api/chat",
            json={"message": "asdfghjkl"},
        )
        assert resp.status_code == 200
        data = resp.get_json()
        assert data["fallback"] is True

    def test_health_still_works(self, client):
        resp = client.get("/health")
        assert resp.status_code == 200
        data = resp.get_json()
        assert data["status"] == "healthy"
        assert data["model_loaded"] is True
        assert data["faq_loaded"] is True


# ---------------------------------------------------------------------------
# 5. Data integrity after admin operations
# ---------------------------------------------------------------------------
class TestDataIntegrity:
    def test_original_dataset_structure_preserved(self, temp_faq_manager):
        df = pd.read_csv(temp_faq_manager.faq_csv, encoding="utf-8")
        required = ["id", "question", "clean_question", "intent", "answer", "entity"]
        for col in required:
            assert col in df.columns, f"Missing column: {col}"

    def test_no_empty_questions_after_operations(self, temp_faq_manager):
        temp_faq_manager.create_faq(
            question="Integrity test",
            intent="help",
            answer="Answer.",
        )
        df = pd.read_csv(temp_faq_manager.faq_csv, encoding="utf-8")
        empty = df["question"].isna() | (df["question"].astype(str).str.strip() == "")
        assert empty.sum() == 0

    def test_no_empty_answers_after_operations(self, temp_faq_manager):
        temp_faq_manager.create_faq(
            question="Integrity answer test",
            intent="help",
            answer="Answer.",
        )
        df = pd.read_csv(temp_faq_manager.faq_csv, encoding="utf-8")
        empty = df["answer"].isna() | (df["answer"].astype(str).str.strip() == "")
        assert empty.sum() == 0

    def test_valid_intents_after_operations(self, temp_faq_manager):
        temp_faq_manager.create_faq(
            question="Intent integrity",
            intent="help",
            answer="Answer.",
        )
        df = pd.read_csv(temp_faq_manager.faq_csv, encoding="utf-8")
        invalid = set(df["intent"].astype(str).str.strip()) - set(CANONICAL_INTENTS)
        assert not invalid, f"Invalid intents found: {invalid}"

    def test_readable_csv_after_operations(self, temp_faq_manager):
        temp_faq_manager.create_faq(
            question="CSV readability",
            intent="help",
            answer="Answer.",
        )
        df = pd.read_csv(temp_faq_manager.faq_csv, encoding="utf-8")
        assert len(df) > 0

    def test_id_stability_after_update(self, temp_faq_manager):
        record = temp_faq_manager.create_faq(
            question="ID stability test",
            intent="help",
            answer="Answer.",
        )
        original_id = record["id"]
        updated = temp_faq_manager.update_faq(
            faq_id=original_id,
            answer="New answer.",
        )
        assert updated["id"] == original_id

    def test_id_stability_after_delete(self, temp_faq_manager):
        record = temp_faq_manager.create_faq(
            question="Delete me",
            intent="help",
            answer="Answer.",
        )
        deleted_id = record["id"]
        temp_faq_manager.delete_faq(deleted_id)
        # Re-create and ensure new ID is different.
        new_record = temp_faq_manager.create_faq(
            question="New record after delete",
            intent="help",
            answer="Answer.",
        )
        assert new_record["id"] != deleted_id
